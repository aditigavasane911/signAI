# FastAPI Server Configuration
APP_NAME=SignAI Backend Service
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=true

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase Authentication & Admin (Optional for backend token verification)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Inference Engine Configuration
CONFIDENCE_THRESHOLD=0.70
FEATURE_DIM=63

# File & Model Paths
DATA_DIR=app/data
ISL_MODEL_FILE=isl_model.json
PHRASES_MODEL_FILE=phrases_model.json
HAND_LANDMARKER_TASK=hand_landmarker.task
