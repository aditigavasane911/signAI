# SignBridge AI Environment Configuration Template
# Copy this file to .env for local overrides

# Optional: Remote Classifier Service URL (defaults to on-device WebAssembly inference)
VITE_CLASSIFIER_API_URL=https://api.signbridge.ai/v1

# Optional: Analytics and Monitoring
VITE_ENABLE_ANALYTICS=false

# Client-Side Feature Flags
VITE_DEMO_MODEL_VERSION=signbridge-isolated-demo-v1.4
VITE_CONFIDENCE_THRESHOLD=0.70
