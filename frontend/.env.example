# SignAI Frontend Environment Configuration
# Copy this file to .env for local development

# Backend API Base URL (FastAPI)
# In local development with Vite proxy, '/api/v1' or 'http://127.0.0.1:8000/api/v1' can be used
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional Remote Classifier Service URL fallback
VITE_CLASSIFIER_API_URL=http://127.0.0.1:8000/api/v1

# Client-Side Feature Flags
VITE_DEMO_MODEL_VERSION=signbridge-isolated-demo-v1.4
VITE_CONFIDENCE_THRESHOLD=0.70
VITE_ENABLE_ANALYTICS=false
