{
  "name": "signai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SignAI - Real-Time Indian Sign Language & Phrase Translation Platform",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "dev:backend": "py -m uvicorn main:app --app-dir backend --reload --port 8000",
    "dev:backend:python": "python -m uvicorn main:app --app-dir backend --reload --port 8000",
    "train:isl": "py backend/scripts/train_isl_model.py",
    "train:phrases": "py backend/scripts/train_phrases_model.py"
  },
  "keywords": [
    "sign-language",
    "mediapipe",
    "computer-vision",
    "fastapi",
    "react",
    "vite",
    "isl"
  ]
}
